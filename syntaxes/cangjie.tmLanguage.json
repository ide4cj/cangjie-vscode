{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cangjie",
  "scopeName": "source.cangjie",
  "comment": "What a file looks like before cjls answers its semantic tokens, and a hover's code, which gets none: comments, strings, numbers, keywords, declared names, parameters, a type by its capital. The server colors the rest of a file (cjls's D19).",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#annotations" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#parameters" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.block.documentation.cangjie", "begin": "/\\*\\*(?!/)", "end": "\\*/", "patterns": [{ "include": "#nested-block-comment" }] },
        { "include": "#nested-block-comment" },
        { "name": "comment.line.double-slash.cangjie", "match": "//.*$" }
      ]
    },
    "nested-block-comment": {
      "name": "comment.block.cangjie",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#nested-block-comment" }]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.multi.raw.cangjie", "begin": "(#+)\"", "end": "\"\\1" },
        { "name": "string.quoted.multi.raw.cangjie", "begin": "(#+)'", "end": "'\\1" },
        { "name": "string.quoted.triple.cangjie", "begin": "\"\"\"", "end": "\"\"\"", "patterns": [{ "include": "#string-content" }] },
        { "name": "string.quoted.triple.cangjie", "begin": "'''", "end": "'''", "patterns": [{ "include": "#string-content" }] },
        { "name": "string.quoted.double.cangjie", "begin": "b?\"", "end": "\"", "patterns": [{ "include": "#string-content" }] },
        { "name": "string.quoted.single.cangjie", "begin": "[br]?'", "end": "'", "patterns": [{ "include": "#string-content" }] }
      ]
    },
    "string-content": {
      "patterns": [
        { "name": "constant.character.escape.cangjie", "match": "\\\\(u\\{[0-9a-fA-F]{1,8}\\}|.)" },
        {
          "name": "meta.interpolation.cangjie",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.cangjie" } },
          "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.cangjie" } },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.cangjie", "match": "\\b0[xX][0-9a-fA-F_]+([iu](8|16|32|64))?\\b" },
        { "name": "constant.numeric.octal.cangjie", "match": "\\b0[oO][0-7_]+([iu](8|16|32|64))?\\b" },
        { "name": "constant.numeric.binary.cangjie", "match": "\\b0[bB][01_]+([iu](8|16|32|64))?\\b" },
        { "name": "constant.numeric.float.cangjie", "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d[\\d_]*)?(f(16|32|64))?\\b" }
      ]
    },
    "annotations": {
      "patterns": [
        { "name": "entity.name.function.macro.cangjie", "match": "@!?[\\p{L}_][\\p{L}\\p{N}_]*" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.cangjie", "match": "\\b(if|else|match|case|for|in|while|do|break|continue|return|throw|try|catch|finally|spawn|synchronized|where)\\b" },
        { "name": "keyword.other.cangjie", "match": "\\b(package|import|macro|quote|as|is|unsafe|foreign|inout|main)\\b" },
        { "name": "storage.type.cangjie", "match": "\\b(class|struct|enum|interface|extend|type|func|prop|let|var|const|init|operator)\\b" },
        { "name": "storage.modifier.cangjie", "match": "\\b(public|protected|private|internal|static|open|abstract|override|redef|sealed|mut|common|specific)\\b" },
        { "name": "constant.language.cangjie", "match": "\\b(true|false)\\b" },
        { "name": "variable.language.cangjie", "match": "\\b(this|super)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.cangjie", "match": "\\b(Int8|Int16|Int32|Int64|IntNative|UInt8|UInt16|UInt32|UInt64|UIntNative|Float16|Float32|Float64|Rune|Bool|Unit|Nothing|This|VArray)\\b" },
        { "name": "entity.name.type.cangjie", "match": "\\b\\p{Lu}[\\p{L}\\p{N}_]*\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(class|struct|enum|interface|type)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": { "1": { "name": "storage.type.cangjie" }, "2": { "name": "entity.name.type.cangjie" } }
        },
        {
          "match": "\\b(func)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": { "1": { "name": "storage.type.cangjie" }, "2": { "name": "entity.name.function.cangjie" } }
        },
        {
          "match": "\\b(prop)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": { "1": { "name": "storage.type.cangjie" }, "2": { "name": "variable.other.property.cangjie" } }
        },
        {
          "match": "\\b(const)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": { "1": { "name": "storage.type.cangjie" }, "2": { "name": "variable.other.constant.cangjie" } }
        },
        {
          "match": "\\b(let|var)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": { "1": { "name": "storage.type.cangjie" }, "2": { "name": "variable.other.cangjie" } }
        }
      ]
    },
    "parameters": {
      "comment": "A name before a type, `x: T` or `x!: T`, the `let` and `var` taken: a parameter, a named argument, a lambda's or a pattern's binding.",
      "patterns": [
        {
          "match": "\\b([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(!)?\\s*(?=:)",
          "captures": { "1": { "name": "variable.parameter.cangjie" }, "2": { "name": "keyword.operator.cangjie" } }
        }
      ]
    },
    "calls": {
      "patterns": [
        { "match": "\\b([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(?=\\()", "captures": { "1": { "name": "entity.name.function.cangjie" } } }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.cangjie", "match": "\\|>|~>|=>|->|<-|<:|\\?\\?|\\.\\.=?|[-+*/%&|^!<>=]=?|\\*\\*=?|&&|\\|\\||<<=?|>>=?|\\?" }
      ]
    }
  }
}
